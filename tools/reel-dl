#!/bin/zsh
# Download Instagram reels (or any yt-dlp link) for use as reference reels.
# Usage: reel-dl <link> [link ...]     add --audio to also save a WAV of the sound
# Saves to $REEL_DL_OUT (default: ./References/): <uploader>_<id>.mp4 plus a .txt with caption, audio name and length.
set -u
OUT="${REEL_DL_OUT:-$PWD/References}"
mkdir -p "$OUT"
audio=0; links=()
for a in "$@"; do [[ $a == --audio ]] && audio=1 || links+=("$a"); done
(( ${#links} )) || { echo "usage: reel-dl <instagram link> [--audio]"; exit 1; }

tpl="$OUT/%(channel,uploader_id|unknown)s_%(id)s.%(ext)s"
opts=(-f "bv*+ba/b" --merge-output-format mp4 --no-playlist --no-overwrites
      -o "$tpl" --print after_move:filepath
      --print-to-file "link: %(webpage_url)s
by: @%(channel,uploader_id)s (%(uploader)s)
audio: %(track,artist|unknown)s
caption: %(description)s" "$OUT/%(channel,uploader_id|unknown)s_%(id)s.txt")

for url in "${links[@]}"; do
  url="${url%%\?*}"   # drop ?igsh= tracking
  echo "→ $url"
  f=$(yt-dlp "${opts[@]}" "$url" 2>/tmp/reel-dl.err) || \
  f=$(yt-dlp "${opts[@]}" --cookies-from-browser chrome "$url" 2>/tmp/reel-dl.err) || \
  f=$(yt-dlp "${opts[@]}" --cookies-from-browser safari "$url" 2>/tmp/reel-dl.err) || {
    echo "  failed: $(tail -1 /tmp/reel-dl.err)"; echo "  (private account or login wall: log in to Instagram in Chrome and retry)"; continue; }
  f=$(echo "$f" | tail -1)
  echo "  saved: $f"
  info=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height:format=duration -of csv=p=0 "$f" | tr '\n' ' ')
  echo "  $info"; echo "size/length: $info" >> "${f%.mp4}.txt"
  if (( audio )); then
    ffmpeg -v error -y -i "$f" -vn -ac 2 -ar 48000 "${f%.mp4}.wav" && echo "  audio: ${f%.mp4}.wav"
  fi
done
